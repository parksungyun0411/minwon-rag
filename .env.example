# data.go.kr 인증키 — "일반 인증키(Decoding)" 값을 넣는다 (httpx가 URL 인코딩함)
DATA_GO_KR_SERVICE_KEY=
# MINWON_API_BASE=https://apis.data.go.kr/1140100/CivilPolicyQnaService
# 개발계정 일 10,000건. 목록+항목 호출 합계 상한
MINWON_DAILY_CALL_BUDGET=9500
MINWON_CALLS_PER_SECOND=5
MINWON_PAGE_SIZE=100

# 시점 분할 (비우면 신청일 90 분위수)
SPLIT_CUTOFF=
EVAL_SIZE=150
SEED=42

# 어휘 검색 백엔드: kiwi_bm25 (기본, 프로세스 내) | opensearch (docker/ 참고, 미검증)
LEXICAL_BACKEND=kiwi_bm25
OPENSEARCH_URL=http://localhost:9200
# 모델 장치: 비우면 mps → cuda → cpu 순으로 자동
MODEL_DEVICE=

# LLM (합성 질의·답변 초안·판정에만 필요). anthropic | openai_compat
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=
